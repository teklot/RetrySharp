<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>RetrySharp</Title>
    <Version>1.2.0</Version>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>RetrySharp is a lightweight, high-performance retry utility for C# with zero external dependencies. Designed for systems where every microsecond and allocation matters.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>RetrySharp</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>retry;resiliency;async;high-performance;lightweight;netstandard2.0</PackageTags>
    <PackageProjectUrl>https://github.com/teklot/retrysharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/retrysharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>
      - Implemented RetryOptions validation: MaxAttempts now throws ArgumentOutOfRangeException if set to 0 or less.
      - Added TimeSpan clamping to prevent overflows and negative delays in delay strategies.
      - Custom DelayStrategy delegates now have their return values automatically clamped.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
